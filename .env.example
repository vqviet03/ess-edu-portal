# Public build-time configuration. Never put secrets here.
NEXT_PUBLIC_API_MODE=real
# URL backend Cloud Run, thêm /v1; URL root cũng tự chuẩn hóa thành /v1.
NEXT_PUBLIC_API_BASE_URL=
NEXT_PUBLIC_API_TIMEOUT_MS=15000
# Empty locally, for user Pages, or for a custom domain served at root.
# Project Pages example: /ess-edu-portal (no trailing slash).
NEXT_PUBLIC_BASE_PATH=
